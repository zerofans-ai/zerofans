{
  "name": "zerofans-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-03",
  "routes": [
    {
      "pattern": "api.zero-fans.com/*",
      "zone_name": "zero-fans.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zerofans-db",
      "database_id": "4743be45-0e76-40c4-a2a7-a3bb33ac5c13",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "zerofans-media"
    }
  ],
  "vars": {
    "JWT_ISSUER": "zerofans-api",
    "JWT_AUDIENCE": "zerofans-web",
    "AI_MODEL": "gpt-4.1-mini",
    "SITE_URL": "https://zero-fans.com"
  }
}
