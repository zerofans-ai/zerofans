{
  "name": "zerofans-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-03",
  "routes": [
    {
      "pattern": "api.zerofans.ai/*",
      "zone_name": "zerofans.ai"
    },
    {
      "pattern": "www.zerofans.ai/api/*",
      "zone_name": "zerofans.ai"
    },
    {
      "pattern": "zerofans.ai/api/*",
      "zone_name": "zerofans.ai"
    },
    {
      "pattern": "www.zerofans.ai/media/*",
      "zone_name": "zerofans.ai"
    },
    {
      "pattern": "zerofans.ai/media/*",
      "zone_name": "zerofans.ai"
    },
    {
      "pattern": "www.zerofans.ai/health",
      "zone_name": "zerofans.ai"
    },
    {
      "pattern": "zerofans.ai/health",
      "zone_name": "zerofans.ai"
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "zerofans-media"
    }
  ],
  "vars": {
    "JWT_ISSUER": "zerofans-api",
    "JWT_AUDIENCE": "zerofans-web",
    "AI_MODEL": "gpt-4.1-mini",
    "AI_MODERATION_MODEL": "omni-moderation-latest",
    "CONTENT_MODERATION_DISABLED": "0",
    "CONTENT_MODERATION_FAIL_CLOSED": "1",
    "SITE_URL": "https://zerofans.ai"
  }
}
