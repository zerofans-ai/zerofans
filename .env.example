# ── Database ──
NEON_CONNECTION_STRING=postgresql://zerofans:zerofans@postgres:5432/zerofans

# ── Auth ──
JWT_SECRET=change-me-to-a-random-secret
JWT_ISSUER=zerofans-api
JWT_AUDIENCE=zerofans-web

# ── Storage ──
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=zerofans-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Content Signing ──
SIGNING_SECRET=change-me-to-a-random-signing-secret

# ── Site ──
SITE_URL=http://localhost:5173

# ── Database (Docker) ──
POSTGRES_PASSWORD=zerofans

# ── MinIO ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── AI (optional) ──
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=gpt-4.1-mini
